// Cloudflare Workers: statyczna apka z public/ + API (/api/*) z worker/index.js + baza D1.
{
  "name": "plusone",
  "account_id": "3b85c6d89850b97817458147e0fd71f6",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/preview", "/preview/*", "/t/*", "/admin/*"],
    // nieznane adresy (np. stare linki) otwierają apkę zamiast pustej strony
    "not_found_handling": "single-page-application"
  },
  // D1-START
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plusone",
      // przy publikacji GitHub Actions podmienia to na id bazy (tworzy ją, jeśli nie istnieje)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // D1-END
  "vars": {
    // sha256 adresów e-mail, które dostają rolę admina (po przecinku)
    "ADMIN_EMAIL_SHA256": "f5b0a493b81b1b8b4876cf0a4e60842484aef9dc06f0e7e07886843c6760e28d,07c652787b6e5fb29fc4d30c5616622a37fb1330864125e323666f8df98667d5,98d88fad716ac648fe26d3d26a86e62dfd7c45ec0d1178ab53ef387fb9c7180f,4e6e0d5f00f86abbca24ca6ef4efb1d9099502fdf1d9457457e4d04154110509",
    // skrót klucza do jednorazowych operacji (np. zaproszenia administratorów); sam klucz nie trafia do repozytorium
    "OPS_KEY_SHA256": "fae9da9f529852a48f5b3e9aab60aaacc10917fc6716290fdedacafeb8973c79",
    // faza rozwoju: aplikacja /app otwarta bez logowania i dla każdego konta; "0" przywraca dostęp tylko z zaproszeniem
    "APP_OPEN": "1"
  },
  "observability": { "enabled": true },
  // alerty co 6 h (worker/premium.js → runAlerts) i newsletter w czwartek ok. 10:00 (NEWSLETTER_CRON)
  "triggers": { "crons": ["17 */6 * * *", "3 8 * * 4"] },
  "workers_dev": true,           // zapasowy adres plusone.jeremi-3b8.workers.dev
  "preview_urls": false,
  // domena w Cloudflare (DNS i certyfikat ustawiają się same przy publikacji)
  "routes": [
    { "pattern": "plusoneapp.pl", "custom_domain": true },
    { "pattern": "www.plusoneapp.pl", "custom_domain": true }
  ]
}
