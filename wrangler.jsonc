// Cloudflare Workers: statyczna apka z public/ + API (/api/*) z worker/index.js + baza D1.
{
  "name": "plusone",
  "account_id": "3b85c6d89850b97817458147e0fd71f6",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/preview", "/preview/*"],
    // nieznane adresy (np. stare linki) otwierają apkę zamiast pustej strony
    "not_found_handling": "single-page-application"
  },
  // D1-START
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plusone",
      // przy publikacji GitHub Actions podmienia to na id bazy (tworzy ją, jeśli nie istnieje)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // D1-END
  "vars": {
    // sha256 adresów e-mail, które dostają rolę admina (po przecinku)
    "ADMIN_EMAIL_SHA256": "f5b0a493b81b1b8b4876cf0a4e60842484aef9dc06f0e7e07886843c6760e28d"
  },
  "observability": { "enabled": true },
  "workers_dev": true,           // zapasowy adres plusone.jeremi-3b8.workers.dev
  "preview_urls": false,
  // domena w Cloudflare (DNS i certyfikat ustawiają się same przy publikacji)
  "routes": [
    { "pattern": "plusoneapp.pl", "custom_domain": true },
    { "pattern": "www.plusoneapp.pl", "custom_domain": true }
  ]
}
