{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)\\.(png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }] }
  ]
}
